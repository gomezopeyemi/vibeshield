# TEMPLATE — committed to git. Placeholders only, NEVER real values.
# Put real values in .env.local (git-ignored).

# --- Auth (your dedicated VibeShield Supabase project) ---
# Browser-safe values: Project Settings → API Keys.
# Use the PUBLISHABLE (or anon) key. The app refuses a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base URL used in verification / reset emails. Required in staging & production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only: lets the server record scan results (public.record_scan) ---
# Supabase → Project Settings → API Keys → a SECRET key (sb_secret_...).
# NEVER prefix with NEXT_PUBLIC_, never commit it. Without it, scans are kept
# in server memory only and the app says so. Uses NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_SECRET_KEY=

# --- Deployment ---
# development | demo | staging | production  (unset: development locally, demo in a production build)
VIBESHIELD_ENV=development
